---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import character from '../assets/character-standing-v1.png';
import modelSheet from '../../assets/Seven-view stylized character model sheet.png';
---
<BaseLayout title="Лендинг — рабочая основа" description="Рабочая основа будущего одностраничного сайта. Проверка графики, адаптивности и движения.">
  <header class="frame header">
    <a href={import.meta.env.BASE_URL} aria-label="Рабочая основа — начало">Рабочая основа</a>
    <a href="#source">Персонаж <span aria-hidden="true">↓</span></a>
  </header>
  <main id="main">
    <section class="frame intro" aria-labelledby="title">
      <div class="intro-copy">
        <h1 id="title">Место для<br />вашей истории.</h1>
        <p>Среда разработки готова. Здесь появится одностраничный сайт с авторским персонажем и выразительными сценами.</p>
        <a class="action" href="#source">Посмотреть исходник <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="hero-media">
        <Image src={character} alt="Стилизованный стройный персонаж с тёмной скульптурной причёской, в графитовой футболке и брюках" widths={[480, 768, 1024]} sizes="(max-width: 760px) 100vw, 50vw" loading="eager" fetchpriority="high" />
      </figure>
    </section>
    <section id="source" class="source" aria-labelledby="source-title">
      <div class="frame source-layout">
        <div>
          <h2 id="source-title">Один характер.<br />Разные ракурсы.</h2>
          <p>Исходный лист задаёт внешность героя. Новые иллюстрации сохранят его пропорции, причёску и пластику.</p>
          <p class="status">Это проверочный стенд. Содержание и сценарий лендинга будут определены после брифа.</p>
        </div>
        <Image class="source-image" src={modelSheet} alt="Оригинальный лист персонажа для сравнения внешности между сценами" widths={[640, 960, 1536]} sizes="(max-width: 760px) 100vw, 55vw" loading="lazy" />
      </div>
    </section>
  </main>
  <footer class="frame footer"><p>Готово к разработке</p><a href="#title">К началу ↑</a></footer>
</BaseLayout>
<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
